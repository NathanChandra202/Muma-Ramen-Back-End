# ============================================
# Muma Ramen Backend - Environment Variables
# ============================================
# Salin file ini menjadi .env lalu isi nilainya
# cp .env.example .env

# Server
PORT=8081

# JWT Secret (ganti dengan string random yang panjang & aman)
JWT_SECRET=ganti-dengan-secret-key-yang-aman-dan-panjang

# Database Mode: "sqlite" atau "postgres"
DB_DRIVER=postgres

# PostgreSQL Connection (isi jika DB_DRIVER=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password_postgres_kamu
DB_NAME=muma_ramen
DB_SSLMODE=disable

# SQLite Path (isi jika DB_DRIVER=sqlite)
DB_PATH=muma_ramen.db
